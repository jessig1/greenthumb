# Copy this file to .env.local (gitignored - see root .gitignore) and fill in real values.
# `make backend-start` / `make up` source .env.local automatically if it exists (see
# backend/Makefile's `start` target) - no need to export these yourself each session.

# Required for the ai/photo-diagnosis endpoints (identify-plant, diagnose, care-suggestions,
# planning-assistant) - without it they return a clear 502 rather than crashing the app.
OPENAI_API_KEY=sk-...
